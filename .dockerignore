# Keep the build context lean. NOTE: samples/, config/, aux_files/ ARE needed
# (sample builds read them), so they are intentionally not ignored.
.git
.venv
**/__pycache__/
**/*.py[cod]

# Frontend build inputs/outputs (frontend is built in its own stage)
kg-service/frontend/node_modules
kg-service/frontend/dist
kg-service/frontend/*.tsbuildinfo
kg-service/frontend/vite.config.js
kg-service/frontend/vite.config.d.ts

# Runtime artifacts
kg-service/.builds
biocypher-log
*.log
output/
output_*/

# Docs/dev cruft
.docx_render
notebooks
# Claude Code worktrees and session files (whole repo copies, with sample data)
.claude
# Local env files hold passwords and secrets. The compose files pass their values in
# when containers start; they must never be baked into the image.
**/*.env
**/.env
!**/*.env.example
!**/.env.example
