# Copy to biocypher-mork/.env (gitignored). Required by docker-compose.yml (env_file).
#   docker compose up -d --build      # first build compiles the Rust server (slow)

# Host dir holding the .metta files, bind-mounted into the container at /app/data.
MORK_DATA_DIR=/path/to/your/metta_output

# Host port mapped to the server's container port 8027. Set to 8432 to match the
# Console/loader default (MORK_URL=http://localhost:8432).
HOST_PORT=8432

# Broad host root mounted at the SAME path (read-only) so the loader can import
# .metta files from ANY directory under it via absolute file://<abs> URIs (not just
# /app/data). Set to the parent that contains your outputs (e.g. DATA_ROOT); defaults
# to MORK_DATA_DIR if unset.
MORK_IMPORT_ROOT=/path/to/your/build_output_root

# Periodic snapshot interval (seconds) for the persistent graph state.
SNAPSHOT_INTERVAL_SECONDS=300
