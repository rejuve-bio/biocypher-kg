# Copy to docker/console.env and edit, then:
#   docker compose --env-file docker/console.env -f docker/docker-compose.stack.yml   up --build
#   docker compose --env-file docker/console.env -f docker/docker-compose.console.yml up --build
#
# Using an --env-file (instead of inline VAR=...) means these apply even under
# `sudo`, which otherwise strips shell environment variables.

# Port the Console is served on (host + container both use this).
CONSOLE_PORT=9000

# Console build concurrency (1 is safe; higher can OOM on full builds).
MAX_CONCURRENT_BUILDS=1

# ── Build output ──
# Absolute host dir, mounted at the SAME path in the container. Blank-output builds
# auto-write to <DATA_ROOT>/<species>-<dataset>-<timestamp>. Keep ARCHIVE_BASE under it.
DATA_ROOT=/home/kedist/biocypher/output

# ── Neo4j (stack service + loader + Observatory read API) ──
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_min_8_chars
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_IMAGE=neo4j:5.21
# Backend → Neo4j. The stack overrides this to bolt://neo4j:7687 internally; set it
# for an EXTERNAL Neo4j (used by the single-container console.yml and the loader).
NEO4J_URI=bolt://localhost:7687

# ── Loading builds into the graph (Console "Load to Neo4j/MORK") ──
# version_manager archive dir (surgical/versioned updates). Keep it under DATA_ROOT
# so it's host-visible and persisted.
ARCHIVE_BASE=/home/kedist/biocypher/output/archives
# MORK server the Console's MORK loader/Observatory talks to. Reachable from the
# container (a hostname/IP, not localhost, unless MORK runs in the same netns).
MORK_URL=http://localhost:8432
