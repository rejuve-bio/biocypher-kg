# ─────────────────────────────────────────────────────────────────────────────
# ONE env file for the whole Console stack. Copy to docker/console.env and edit.
#
# Works with every compose file (each reads the keys it needs):
#   docker compose --env-file docker/console.env -f docker/docker-compose.dev.yml     up --build
#   docker compose --env-file docker/console.env -f docker/docker-compose.console.yml up --build
#   docker compose --env-file docker/console.env -f docker/docker-compose.stack.yml   up --build
#
# ...and for the Makefile Neo4j targets (loader/version_manager):
#   make neo4j-up   NEO4J_ENV_FILE=docker/console.env
#   make neo4j-load NEO4J_ENV_FILE=docker/console.env
#
# Using --env-file also works under `sudo` (which strips inline VAR=... vars).
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ──
CONSOLE_PORT=9000        # single-container (console.yml) & stack (stack.yml)
FRONTEND_PORT=5173       # dev split (dev.yml) — Vite
BACKEND_PORT=9000        # dev split (dev.yml) — FastAPI

# ── Build output ──
# Absolute host dir, mounted at the SAME path in the container. Blank output builds
# auto-write to <DATA_ROOT>/<species>-<dataset>-<timestamp>. Set to where you want
# outputs to live on the host.
DATA_ROOT=/home/kedist/biocypher/output
MAX_CONCURRENT_BUILDS=1

# ── Neo4j (stack service + loader + Observatory read API) ──
NEO4J_IMAGE=neo4j:5.21
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_min_8_chars
NEO4J_DATABASE=neo4j
# Backend → Neo4j. The stack.yml overrides this to bolt://neo4j:7687 internally;
# set it for an EXTERNAL Neo4j when not using the stack.
NEO4J_URI=bolt://localhost:7687
# Used by the neo4j-only compose (docker-compose.neo4j.yml) + Makefile targets:
NEO4J_AUTH=neo4j/change_me_min_8_chars
NEO4J_OUTPUT_DIR=/home/kedist/biocypher/output      # loader import root (file:/// CSVs)
ARCHIVE_BASE=/home/kedist/biocypher/archives        # version_manager archive dir

# ── MORK (optional) ──
MORK_URL=http://localhost:8432
MORK_LIVE_STATS_ENABLED=false
