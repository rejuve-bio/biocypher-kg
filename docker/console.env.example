# ─────────────────────────────────────────────────────────────────────────────
# THE env file for the BioCypher KG Console stack.
#   cp docker/console.env.example docker/console.env   # set the two REQUIRED values
#   ./docker/up.sh                                      # attach-or-create DBs, then Console
#
# up.sh decides per database: reuse the bundled service if already running; else
# attach to an existing instance (remote NEO4J_HOST/MORK_HOST, or one already on the
# local port); else create the bundled one.
#
# The compose has sensible defaults for everything else — you normally only set
# the two values below. Uncomment an "optional" line only to override its default.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──
# Absolute host dir for build output + archives. The ONLY path you set; it's mounted
# at the same path into every service so loads resolve automatically.
DATA_ROOT=/absolute/path/to/kg-data
# Neo4j password (min 8 chars) — used for the Neo4j container and the Console loader.
NEO4J_PASSWORD=change_me_min_8_chars

# ── ATTACH TO EXISTING INSTANCES (optional; used by up.sh) ──
# Leave HOST blank to use THIS host: up.sh attaches to an instance already on the
# port below, or creates the bundled service if the port is free. Set HOST to a
# remote machine to attach to a DB running elsewhere (it must already be reachable —
# up.sh cannot create a DB on another box). The port is the endpoint up.sh probes.
#NEO4J_HOST=                # blank = this host; or e.g. neo4j.internal / 10.0.0.5
#MORK_HOST=                 # blank = this host; or e.g. mork.internal / 10.0.0.6

# ── OPTIONAL (defaults shown; uncomment to change) ──
#CONSOLE_PORT=9000          # Console UI + API           → http://localhost:9000/console/
#NEO4J_HTTP_PORT=7474       # Neo4j Browser              → http://localhost:7474
#NEO4J_BOLT_PORT=7687       # Neo4j bolt — probed by up.sh; also the bundled host port
#MORK_HOST_PORT=8432        # MORK port — probed by up.sh; also the bundled host port
#NEO4J_PAGECACHE=1G         # Neo4j memory — raise on hosts with more RAM (e.g. 4G)
#NEO4J_HEAP_MAX=1G
#NEO4J_USER=neo4j
#NEO4J_DATABASE=neo4j
#NEO4J_IMAGE=neo4j:5.21
#MAX_CONCURRENT_BUILDS=1

# ── Neo4j / APOC flags the stack applies (suggested defaults; override only if needed).
# These make the file-based loader work; the loader uses apoc.periodic.iterate +
# plain LOAD CSV, so the file-import/export toggles below are the safe proven values.
#NEO4J_APOC_EXPORT_FILE=true
#NEO4J_APOC_IMPORT_FILE=true
#NEO4J_APOC_IMPORT_USE_CONFIG=false
