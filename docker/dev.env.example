# Dev stack ports. Copy to docker/dev.env, set free ports, then:
#   docker compose --env-file docker/dev.env -f docker/docker-compose.dev.yml up --build
#
# Using --env-file (not inline VAR=...) means these apply even under `sudo`,
# which strips shell environment variables.
#
#   Frontend UI: http://localhost:<FRONTEND_PORT>/console/
#   Backend API: http://localhost:<BACKEND_PORT>/docs

# Host port for the Vite dev server (frontend). The container listens on the SAME
# port so hot reload works. Pick one that's free on your machine.
FRONTEND_PORT=5173

# Host port for the FastAPI backend (direct API/docs access). The frontend reaches
# the backend internally over the compose network, so this only affects host access.
BACKEND_PORT=9000

# Build concurrency (1 is safe).
MAX_CONCURRENT_BUILDS=1

# Absolute host directory for CUSTOM build outputs. It's mounted at the SAME path
# inside the container, so the "Output directory" you type in the wizard is the
# EXACT same folder on your host (no translation). Set it to wherever you want
# outputs to live, e.g. /home/kedist/kg-output. Then in the wizard use that path or
# a subfolder of it (e.g. /home/kedist/kg-output/my-run).
# Must be an ABSOLUTE path. Leave the wizard field blank to use the default
# (host kg-service/.builds/<job-id>/output).
HOST_OUTPUT_DIR=/data/kg-output
